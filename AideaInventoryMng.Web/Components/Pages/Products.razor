
@page "/products" 

@using System.Net.Http.Json
@using AideaInventoryMng.Web.Models

@inject HttpClient Http


<PageTitle>商品管理</PageTitle>

<div class="product-page">
	<div class="page-header">


		<div class="page-title">
			<h2>商品管理</h2>
			<p>承認の登録・検索・編集・削除を行います。</p>
		</div>

		<button class="btn-primary" disabled>
			＋ 商品登録
		</button>
	</div>

	<div class="search-area">
		<input type="text"
			   placeholder="商品コード・商品名で検索"
			   @bind="_searchText"
			   @bind:event="oninput" />
		<button class="btn-search" @onclick="SearchProducts">
			検索
		</button>
	</div>

	<div class="product-table-container">
		<table class="product-table">
			<thead>
				<tr>
					<th>商品コード</th>
					<th>商品名</th>
					<th>単価</th>
					<th>単位</th>
					<th>最低在庫数</th>
					<th>操作</th>
					
				</tr>
			</thead>
			
			<tbody>
				@if (_isLoading)
				{
					<tr>
						<td colspan="6" class="empty-message">
							商品データを読み込んでいます...
						</td>
					</tr>
				}
				else if (!string.IsNullOrEmpty(_errorMessage))
				{
					<tr>
						<td colspan="6" class="empty-message">
							@_errorMessage
						</td>
					</tr>
				}
				else if (_filteredProducts.Count == 0)
				{
					<tr>
						<td colspan="6" class="empty-message">
							@(_products.Count == 0
								? "商品データがありません。"
								: "検索条件に一致する商品がありません。")
						</td>
					</tr>
				}
				else
				{
					@foreach (var product in _filteredProducts)
					{
						<tr>
							<td>@product.ProductCode</td>
							<td>@product.Name</td>
							<td>@product.Price.ToString("N2")</td>
							<td>@product.Unit</td>
							<td>@(product.MinStockQuantity?.ToString() ?? "未定")</td>
							<td>-</td>
					
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
</div>


	

@code {
	private List<ProductResponse> _products = new();

	private List<ProductResponse> _filteredProducts = new();

	private string _searchText = string.Empty;

	private bool _isLoading = true;

	private string? _errorMessage;

	// 画面表示時に商品一覧を取得
	protected override async Task OnInitializedAsync()
	{
		await LoadProductAsync();
	}

	// 商品一覧取得
	private async Task LoadProductAsync()
	{
		try
		{
			_isLoading = true;
			_errorMessage = null;

			var result = await Http.GetFromJsonAsync<List<ProductResponse>>(
				"api/Products");

			_products = result ?? new List<ProductResponse>();

			_filteredProducts = _products.ToList();
		}
		catch (HttpRequestException ex)
		{
			_errorMessage = $"商品一覧の取得に失敗しました。APIの接続を確認してください。詳細：{ex.Message}";
		}
		catch (System.Text.Json.JsonException ex)
		{
			_errorMessage = $"商品データの読み込みに失敗しました。詳細：{ex.Message}";
		}
		finally
		{
			_isLoading = false;
		}
	}

	// 商品コード・商品名で検索
	private void SearchProducts()
	{
		if (string.IsNullOrWhiteSpace(_searchText))
		{
			_filteredProducts = _products.ToList();
			return;
		}

		_filteredProducts = _products.Where(product =>
		product.ProductCode.Contains
		(
			_searchText,
			StringComparison.OrdinalIgnoreCase) 
			||
			product.Name.Contains(
				_searchText,
				StringComparison.OrdinalIgnoreCase)
		)
		.ToList();
	}
}

