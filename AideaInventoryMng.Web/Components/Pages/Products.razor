@page "/products"

@using System.Net.Http.Json
@using System.Text.Json
@using AideaInventoryMng.Web.Models

@inject HttpClient Http

<PageTitle>商品管理</PageTitle>

<div class="container-fluid">

    <!-- ページ見出し -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-2">商品管理</h2>
            <p class="text-muted mb-0">
                商品の登録・検索・編集・削除を行います。
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="OpenCreateForm">
            ＋ 商品登録
        </button>
    </div>

    <!-- 商品検索 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <input type="text"
                           class="form-control"
                           placeholder="商品コード・商品名で検索"
                           @bind="_searchText"
                           @bind:event="oninput" />
                </div>

                <div class="col-auto">
                    <button class="btn btn-outline-primary"
                            @onclick="SearchProducts">
                        検索
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 商品一覧 -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h3 class="h5 mb-0">商品一覧</h3>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>商品コード</th>
                            <th>商品名</th>
                            <th class="text-end">単価</th>
                            <th>単位</th>
                            <th class="text-end">最低在庫数</th>
                            <th class="text-center">操作</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (_isLoading)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    商品データを読み込んでいます...
                                </td>
                            </tr>
                        }
                        else if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <tr>
                                <td colspan="6" class="text-center text-danger py-4">
                                    @_errorMessage
                                </td>
                            </tr>
                        }
                        else if (_filteredProducts.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    @(_products.Count == 0
                                        ? "商品データがありません。"
                                        : "検索条件に一致する商品がありません。")
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in _filteredProducts)
                            {
                                <tr>
                                    <td>@product.ProductCode</td>
                                    <td>@product.Name</td>
                                    <td class="text-end">
                                        @product.Price.ToString("N2")
                                    </td>
                                    <td>@product.Unit</td>
                                    <td class="text-end">
                                        @(product.MinStockQuantity?.ToString() ?? "未定")
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-outline-primary"
                                        @onclick="()=> OpenEditForm(product)">
                                       編集
                                        </button>

                                        <button class="btn btn-outline-danger btn-sm ms-2"
                                        @onclick="() => OpenDeleteConfirm(product)">
                                            削除
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 商品登録フォーム -->
    @if (_isCreateFormVisible)
    {
        <div class="modal fade show d-block"
             tabindex="-1"
             role="dialog"
             aria-modal="true">


            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">商品登録</h5>

                        <button type="button"
                            class="btn-close"
                            @onclick="CancelCreateForm"
                            >
                        </button>
                    </div>


                    <div class="modal-body">

                        @if (!string.IsNullOrEmpty(_createErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_createErrorMessage
                            </div>
                    
                        }

                        <div class="mb-3">
                            <label class="form-label">商品コード</label>
                            <input type="text" 
                                   class="form-control @(_productCodeError != null ? "is-invalid" : "")"
                                maxlength="50"
                                @bind="_productCode"/>

                            @if (_productCodeError != null)
                            {
                                <div class="text-danger small mt-1">
                                    @_productCodeError
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">商品名</label>
                            <input type="text" 
                                   class="form-control @(_productNameError != null ? "is-invalid" : "")"
                                maxlength="200"
                                @bind="_productName"/>
                            @if (_productNameError != null)
                            {
                                <div class="text-danger small mt-1">
                                    @_productNameError
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">単価</label>
                            <input type="number" 
                                   class="form-control @(_unitPriceError != null ? "is-invalid" : "")"
                                min="0"
                                step=".01"
                                @bind="_price"/>

                            @if (_unitPriceError != null)
                            {
                                <div class="text-danger small mt-1">
                                    @_unitPriceError
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">単位</label>
                            <input type="text" 
                                   class="form-control @(_unitError != null ? "is-invalid" : "")"
                                maxlength="20"
                                @bind="_unit"/>
                            @if (_unitError != null)
                            {
                                <div class="text-danger small mt-1">
                                    @_unitError
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">最低在庫数</label>
                            <input type="number"
                                class="form-control @(_minStockQuantityError != null ? "is-invalid" : "")"
                                min="0"
                                step="1"
                                @bind="_minStockQuantity"/>
                            @if (_minStockQuantityError != null)
                            {
                                <div class="text-danger small mt-1">
                                    @_minStockQuantityError
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary"
                                @onclick="CancelCreateForm">
                            キャンセル
                        </button>

                        <button class="btn btn-primary"
                            @onclick="CreateProductAsync"
                            disabled="@_isSaving">
                            @(_isSaving ? "登録中..." : "登録")
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
    
    <!-- 商品編集モーダル -->
    @if (_isEditModalVisible)
    {
        <div class="modal fade show d-block"
        tabindex="-1"
        role="dialog"
        aria-modal="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">商品編集</h5>
                    <button type="button"
                        class="btn-close"
                    @onclick="CloseEditModal">
                    </button>
                </div>


                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">商品コード</label>
                        <input type="text"
                            class="form-control"
                            value="@_editProductCode" 
                            readonly/>
                       
                    </div>

                    <div class="mb-3">
                        <label class="form-label">商品名</label>
                        <input type="text"
                            class="form-control"
                            maxlength="200"
                            @bind="@_editProductName"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">単価</label>
                        <input type="number"
                            class="form-control"
                            min="0"
                            step=".01"
                            @bind="@_editPrice"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">単位</label>
                        <input type="text"
                            class="form-control"
                            maxlength="20"
                            @bind="@_editUnit"/>
                        </div>

                    <div class="mb-3">
                        <label class="form-label">最低在庫数</label>
                        <input type="number"
                            class="form-control"
                            min="0"
                            step="1"
                            @bind="@_editMinStockQuantity"/>
                    </div>

                </div>

                @if (!string.IsNullOrEmpty(_editErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @_editErrorMessage
                    </div>
                }

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="CloseEditModal">
                        キャンセル
                    </button>

                    <button class="btn btn-primary" 
                           @onclick="UpdateProductAsync"
                           disabled ="@_isUpdating">
                            @(_isUpdating ? "更新中..." : "更新")
                    </button>
                </div>

            </div>

        </div>

        </div>
        
    }

    <!-- 商品削除フォーム -->
    @if (_isDeleteModalVisible)
    {
        <div class="modal fade show d-block"
        tabindex="1"
        role="dialog"
        aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">商品削除確認</h5>
                        
                        <button type="button"
                                class="btn-close"
                                @onclick="CloseDeleteModal"
                        disabled="@_isDeleting">
                        </button>
                    </div>

                    <div class="modal-body">
                    
                        <p>以下の商品を削除しますか？</p>

                        <div class="mb-3">
                            <label class="form-label">商品コード</label>
                            <input type="text"
                                   class="form-control"
                                   value="@_deleteProductCode"
                                   readonly />
                       
                        </div>

                        <div class="mb-3">
                            <label class="form-label">商品名</label>
                            <input type="text"
                                   class="form-control"
                                   @bind="@_deleteProductName"
                                   readonly />
                        </div>

                        <div class="alert alert-warning mb-0">
                            この商品は論理削除され、通常の商品一覧に表示されなくなります。
                        </div>

                        @if (!string.IsNullOrEmpty(_deleteErrorMessage))
                        {
                            <div class="alert alert-danger mt-3 mb-0">
                                @_deleteErrorMessage
                            </div>
                            
                        }
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary"
                                @onclick="CloseDeleteModal"
                        disabled="@_isDeleting">
                            キャンセル
                        </button>

                        <button class="btn btn-danger"
                                @onclick="DeleteProductAsync"
                                disabled="@_isUpdating">
                            @(_isUpdating ? "削除中..." : "削除する")
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
    }


</div>

@if (_isSuccessModalVisible)
{
    <div class="modal fade show d-block"
        tabindex="-1"
        role="dialog"
        aria-modal="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                
                <div class="modal-header">
                    <h5 class="modal-title">@_successModalTitle</h5>
                </div>

                <div class="modal-body text-center py-4">
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success"
                        style="font-size: 3rem;">

                        </i>
                    </div>

                    <p class="mb-0">@_successModalMessage</p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button class="btn btn-primary px-4"
                            @onclick="CloseSuccessModal">
                        OK
                    </button>
                </div>
            </div>

        </div>
    </div>
    
}

@code {
    private List<ProductResponse> _products = new();

    private List<ProductResponse> _filteredProducts = new();

    private string _productCode = string.Empty;

    private string _productName = string.Empty;

    private decimal? _price;

    private string _unit = string.Empty;

    private int? _minStockQuantity;

    private string _searchText = string.Empty;

    private bool _isLoading = true;

    private string? _errorMessage;
    
    // 登録成功モーダルの表示状態
    private bool _isSuccessModalVisible = false;

    private string _successModalTitle = string.Empty;

    private string _successModalMessage = string.Empty;

    // 商品登録処理の状態
    private bool _isSaving = false;

    //商品登録時のエラーメッセージ
    private string? _createErrorMessage;

    // 商品更新時のエラーメッセージ
    private string? _editErrorMessage;

    // 商品登録の入力チェックエラー
    private string? _productCodeError;
    private string? _productNameError;
    private string? _unitError;
    private string? _unitPriceError;
    private string? _minStockQuantityError;

    // 商品登録フォームの表示状態
    private bool _isCreateFormVisible = false;

    // 商品編集フォームの表示状態
    private bool _isEditModalVisible = false;

    // 編集対象の商品ID
    private long _editProductId;

    // 編集対象のVersion
    private int _editVersion;

    // 編集用の商品情報
    private string _editProductCode = string.Empty;
    private string _editProductName = string.Empty;
    private decimal _editPrice;
    private string _editUnit = string.Empty;
    private int? _editMinStockQuantity;

    // 商品更新処理の状態
    private bool _isUpdating = false;



    <!-- 削除関係 -->
    // 商品削除確認モーダルの表示状態
    private bool _isDeleteModalVisible = false;

    // 削除対象の商品情報
    private long _deleteProductId;
    private string _deleteProductCode = string.Empty;
    private string _deleteProductName = string.Empty;

    // 商品削除処理の状態
    private bool _isDeleting = false;

    // 商品削除時のエラーメッセージ
    private string? _deleteErrorMessage;

    // 画面表示時に商品一覧を取得
    protected override async Task OnInitializedAsync()
    {
        await LoadProductAsync();
    }

    // 商品一覧取得
    private async Task LoadProductAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            var result = await Http.GetFromJsonAsync<List<ProductResponse>>(
                "api/Products");

            _products = result ?? new List<ProductResponse>();

            _filteredProducts = _products.ToList();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"商品一覧の取得に失敗しました。APIの接続を確認してください。詳細：{ex.Message}";
        }
        catch (System.Text.Json.JsonException ex)
        {
            _errorMessage = $"商品データの読み込みに失敗しました。詳細：{ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // 商品コード・商品名で検索
    private void SearchProducts()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _filteredProducts = _products.ToList();
            return;
        }

        _filteredProducts = _products.Where(product =>
            product.ProductCode.Contains(
                _searchText,
                StringComparison.OrdinalIgnoreCase)
            ||
            product.Name.Contains(
                _searchText,
                StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    // 商品登録フォームを表示する
    private void OpenCreateForm()
    {
        _createErrorMessage = null;
        _productCodeError = null;
        _productNameError = null;
        _unitError = null;
        _unitPriceError = null;
        _minStockQuantityError = null;

        _isCreateFormVisible = true;
    }

    // 商品編集フォームを表示する
    private void OpenEditForm(ProductResponse product)
    {
        // 編集対象の商品情報をセット
        _editProductId = product.Id;
        _editVersion = product.Version;
        _editProductCode = product.ProductCode;
        _editProductName = product.Name;
        _editPrice = product.Price;
        _editUnit = product.Unit;
        _editMinStockQuantity = product.MinStockQuantity;

        // 編集モーダルを表示
        _isEditModalVisible = true;
    }

    // 商品登録フォームをキャンセルする
    private void CancelCreateForm()
    {
        _productCode = string.Empty;
        _productName = string.Empty;
        _price = 0;
        _unit = string.Empty;
        _minStockQuantity = null;

        _createErrorMessage = null;
        _productCodeError = null;
        _productNameError = null;
        _unitError = null;
        _unitPriceError = null;
        _minStockQuantityError = null;

        _isCreateFormVisible = false;
    }

    //商品を登録する
    private async Task CreateProductAsync()
    {
        _createErrorMessage = null;
        _productCodeError = null;
        _productNameError = null;
        _unitError = null;
        _unitPriceError = null;
        _minStockQuantityError = null;

        // 入力チェック
        if (string.IsNullOrWhiteSpace(_productCode))
        {
            _productCodeError = "商品コードを入力してください。";
        }

        if (string.IsNullOrWhiteSpace(_productName))
        {
            _productNameError = "商品名を入力してください。";
        }

        // 単価チェック
        if (_price == null)
        {
            _unitPriceError = "単価を入力してください。";
        }
        else if (_price < 0)
        {
            _unitPriceError = "0以上の単価を入力してください。";
        }

        if (string.IsNullOrWhiteSpace(_unit))
        {
            _unitError = "単位を入力してください。";
        }

        if (_minStockQuantity == null)
        {
            _minStockQuantityError = "最低在庫数を入力してください。";
        }
        else if (_minStockQuantity < 0)
        {
            _minStockQuantityError = "0以上の整数を入力してください。";
        }

        // 入力エラーがあれば登録処理を終了
        if (_productCodeError != null ||
            _productNameError != null ||
            _unitError != null ||
            _unitPriceError != null ||
            _minStockQuantityError != null)
        {
            return;
        }

        //登録リクエストを作成
        var request = new CreateProductRequest
            {
                ProductCode = _productCode,
                Name = _productName,
                Description = null,
                Price = _price.Value,
                Unit = _unit,
                MinStockQuantity = _minStockQuantity
            };

        try
        {
            _isSaving = true;

            //商品登録APIを呼び出す
            var response = await Http.PostAsJsonAsync(
                "api/Products", 
                request
            );

            if (!response.IsSuccessStatusCode)
            {
                var errorContent = await response.Content.ReadAsStringAsync();

                if ((int)response.StatusCode == 409)
                {
                    try
                    {
                        using var document = JsonDocument.Parse(errorContent);

                        if (document.RootElement.TryGetProperty("message", out var message))
                        {
                            _productCodeError = message.GetString() ?? "この商品コードは既に登録されています。";

                        }
                        else
                        {
                            _productCodeError = "この商品コードは既に登録されています。";
                        }


                    }
                    catch (JsonException)
                    {
                        _productCodeError = "この商品コードは既に登録されています。";
                    }

                    return;
                }


                _createErrorMessage =
                    $"商品登録に失敗しました。HTTPステータス：{(int)response.StatusCode} 詳細:{errorContent}";

                return;
            }

            // 入力値を初期化
            _productCode = string.Empty;
            _productName = string.Empty;
            _price = 0;
            _unit = string.Empty;
            _minStockQuantity = null;

            // 成功モーダルのメッセージを設定
            _successModalTitle = "商品登録完了";
            _successModalMessage = "商品を登録しました。";


            // Formを閉じる
            _isCreateFormVisible = false;

            //商品一覧を再取得
            await LoadProductAsync();

            // 登録・更新共通の成功モーダル表示状態
            _isSuccessModalVisible = true;
        }
        catch (HttpRequestException ex)
        {
            _createErrorMessage =
                $"商品登録APIとの通信に失敗しました。詳細：{ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }


    }

    // 商品を更新する
    private async Task UpdateProductAsync()
    {
        _editErrorMessage = null;

        // 更新リクエストを作成
        var request = new UpdateProductRequest
        {
            Name = _editProductName,
            Description = null,
            Price = _editPrice,
            Unit = _editUnit,
            MinStockQuantity = _editMinStockQuantity,
            Version = _editVersion
        };

        try
        {
            _isUpdating = true;

            // 商品更新APIを呼び出す
            var response = await Http.PutAsJsonAsync(
                $"api/Products/{_editProductId}",
                request
            );

            // Version不一致
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _editErrorMessage = 
                "他のユーザーによって商品情報が更新されています。一覧を再読み込みして、もう一度編集してください。";

                return;
            }

            // 商品が存在しない
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _editErrorMessage =
                    "更新対象の商品が見つかりません。";

                return;
            }

            // その他のエラー
            if (!response.IsSuccessStatusCode)
            {
                var errorContent =
                    await response.Content.ReadAsStringAsync();

                _editErrorMessage =
                    $"商品更新に失敗しました。HTTPステータス：{(int)response.StatusCode} 詳細：{errorContent}";

                return;
            }

            //編集モーダルを閉じる
            _isEditModalVisible = false;

            // 商品一覧を再取得
            await LoadProductAsync();

            // 成功モーダルのメッセージを設定
            _successModalTitle = "商品更新完了";
            _successModalMessage = "商品を更新しました。";

            // 登録・更新共通の成功モーダル表示状態
            _isSuccessModalVisible = true;

        }
        catch (HttpRequestException ex)
        {
            _editErrorMessage = 
            $"商品更新APIとの通信に失敗しました。詳細：{ex.Message}";

        }
        finally
        {
            _isUpdating = false;

        }

    }


    private void OpenDeleteConfirm(ProductResponse product)
    {
        // 削除対象の商品情報をセット
        _deleteProductId = product.Id;
        _deleteProductCode = product.ProductCode;
        _deleteProductName = product.Name;

        _deleteErrorMessage = null;

        // 削除確認モーダルを表示
        _isDeleteModalVisible = true;

        
    }

    // 登録・更新共通の成功モーダルを閉じる
    private void CloseSuccessModal()
    {
        _isSuccessModalVisible = false;
    }

    private void CloseEditModal()
    {
        _isEditModalVisible= false;
    }

    private void CloseDeleteModal()
    {
        _isDeleteModalVisible = false;
        _deleteErrorMessage = null;
    }

    private async Task DeleteProductAsync()
    {
        _editErrorMessage = null;

        try
        {
            _isDeleting = true;
           
            // 商品更新APIを呼び出す
            var response = await Http.DeleteAsync(
                $"api/Products/{_deleteProductId}");

            // 商品が存在しない場合（HTTP 404）
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _deleteErrorMessage =
                    "対象の商品が見つかりません。商品一覧を再読み込みしてください。";
                return;
            }

            // バージョン競合など（HTTP 409）
            if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _deleteErrorMessage =
                    "商品情報が他の処理で変更された可能性があります。商品一覧を再読み込みして確認してください。";
                return;
            }

            // その他のエラー
            var errorContent = await response.Content.ReadAsStringAsync();

            _deleteErrorMessage =
                $"商品削除に失敗しました。HTTPステータス：{(int)response.StatusCode} 詳細：{errorContent}";
  
            // 削除成功（HTTP 204）
            if(response.IsSuccessStatusCode){
                // 削除確認モーダルを閉じる
                _isDeleteModalVisible = false;

                // 商品一覧を再取得
                await LoadProductAsync();

                // 成功モーダルを表示
                _successModalTitle = "商品削除完了";
                _successModalMessage = "商品を削除しました。";
                _isSuccessModalVisible = true;

                return;
            }

        }
        catch (HttpRequestException ex)
        {
            _deleteErrorMessage =
            $"商品削除APIとの通信に失敗しました。詳細：{ex.Message}";
        }
        finally
        {
            _isDeleting = false;
        }
    }

}
